# ---------------------------------------------------------------------------
# Android / Gradle build output
# ---------------------------------------------------------------------------
*.apk
*.aab
*.ap_
*.dex
*.class
*.hprof

build/
.gradle/
.kotlin/
captures/
.externalNativeBuild/
.cxx/
out/

# Release / distribution artifacts
dist/
app/release/

# JVM crash & log files
*.log
hs_err_pid*

# ---------------------------------------------------------------------------
# Signing & secrets (never commit these)
# ---------------------------------------------------------------------------
keystore.properties
keystore/
secrets.properties
*.jks
*.keystore

# Local SDK path — generated by Android Studio / Gradle, machine specific
local.properties

# ---------------------------------------------------------------------------
# IDE files
# ---------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws

# VS Code — keep shared project config, ignore local state
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json

# ---------------------------------------------------------------------------
# OS metadata
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*~

# ---------------------------------------------------------------------------
# Local tooling state (Java upgrade assistant hooks / session data)
# ---------------------------------------------------------------------------
.github/modernize/
